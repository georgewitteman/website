{
  "extends": [
    "@tsconfig/node26/tsconfig.json",
    // https://nodejs.org/api/typescript.html#type-stripping
    "@tsconfig/node-ts/tsconfig.json"
  ],
  "compilerOptions": {
    "noEmit": true,
    // Required as of TypeScript 7: @types/node is no longer picked up
    // implicitly, so `process` in playwright.config.ts fails to resolve.
    "types": ["node"]
  }
}
